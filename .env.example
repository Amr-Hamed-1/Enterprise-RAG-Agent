# ===== Enterprise RAG Agent — environment template =====
# Copy this file to `.env` and fill in your values.

# Groq (LLM: llama-3.3-70b rewrite + llama-3.1-8b generation)
GROQ_API_KEY=

# Qdrant Cloud cluster
QDRANT_URL=
QDRANT_API_KEY=

# Optional: API guardrails (defaults shown)
MAX_REQUESTS_PER_MINUTE=10
MAX_QUERY_LENGTH=500

# UI -> API address (docker-compose overrides this automatically)
API_BASE=http://127.0.0.1:8000
